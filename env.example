# VoiceScribe Studio Environment Configuration
# Copy this file to .env and fill in your actual API keys and credentials

# --- Required API Keys ---
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Authentication Credentials ---
# Tester Access (for shared testing)
TESTER_USERNAME=voicescribe_tester
TESTER_PASSWORD=your_secure_tester_password_here

# Admin Access (for analytics and testing suite)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# --- Optional Configuration ---
# DeepSeek API Configuration
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Claude Model Configuration
CLAUDE_MODEL=claude-3-7-sonnet-20250219

# Default Voice ID (optional, app has presets)
VOICE_ID=default

# Port Configuration (Railway automatically sets this)
PORT=7860

# --- Optional: Custom Voice IDs ---
# Male Voices
MALE_VOICE_1=jn5Dym9tbXQdxJRlyYzZ  # Dan Teacher - Natural
MALE_VOICE_2=CMtJJeUfoLE6mZYBmsFl  # Dan Teacher - Neutral  
MALE_VOICE_3=W14NZHmEOKlltX7Dhrac  # Dan Teacher - Upbeat
