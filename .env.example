# API Keys for VoiceScribe Studio
# OPENAI_API_KEY=your_openai_api_key_here # Removed
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Base URLs 
# OPENAI_BASE_URL= # Removed
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1 # Official DeepSeek endpoint
# ANTHROPIC_BASE_URL= # Anthropic client uses default, usually not needed

# Optional Configuration
# OPENAI_MODEL=gpt-4o # Removed
DEEPSEEK_MODEL=deepseek-chat # Reverted default DeepSeek model
CLAUDE_MODEL=claude-3-5-sonnet-20240620 # Default Claude model
VOICE_ID=default # default ElevenLabs voice ID

