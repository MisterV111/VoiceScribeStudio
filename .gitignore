# Environments and configuration
.env
.venv
venv/
ENV/
env/
env.bak/
venv.bak/
*.env
__pycache__/
*.py[cod]
*$py.class

# Output files
output/audio/*
output/scripts/*
# Keep the output directories, but not their contents
!output/audio/.gitkeep
!output/scripts/.gitkeep

# Test results
app/test_results/
!app/test_results/.gitkeep

# Temporary output files
temp_output/
!temp_output/.gitkeep

# Distribution / packaging
dist/
build/
*.egg-info/

# Test files in root directory (legacy)
/test_*.py
/test_*.mp3
/test_*.wav
/test_*.ogg
/debug_*.py

# Tests directory (allow all files in tests directory)
tests/*
!tests/.gitkeep
!tests/*.py
!tests/*.md
!tests/test_*.mp3
!tests/archived_tests/
!tests/archived_tests/*.py
!tests/archived_tests/*.md
# Allow new test directory structure
!tests/__init__.py
!tests/unit/
!tests/unit/**
!tests/integration/
!tests/integration/**
!tests/components/
!tests/components/**
!tests/scripts/
!tests/scripts/**

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db 